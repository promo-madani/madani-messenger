{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ] }
    ],
    "rewrites": [{ "source": "/link", "destination": "/index.html" }]
  },
  "emulators": {
    "auth": { "port": 9099, "host": "127.0.0.1" },
    "firestore": { "port": 8085, "host": "127.0.0.1" },
    "storage": { "port": 9199, "host": "127.0.0.1" },
    "functions": { "port": 5001, "host": "127.0.0.1" },
    "hosting": { "port": 5050, "host": "127.0.0.1" },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
