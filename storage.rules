rules_version = '2';

// Files, photos and voice notes are stored per conversation: files/<convId>/<random>/<name>.
// Only people who can see the conversation can upload to it or open its files.
service firebase.storage {
  match /b/{bucket}/o {
    function conv(cid) { return firestore.get(/databases/(default)/documents/convs/$(cid)).data; }
    function isMember() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function canSee(cid) { return isMember() && (conv(cid).type == 'channel' || request.auth.uid in conv(cid).members); }

    match /files/{cid}/{rest=**} {
      allow read: if canSee(cid);
      allow create: if canSee(cid) && request.resource.size < 200 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /avatars/{uid}/{rest=**} {
      allow read: if isMember();
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
